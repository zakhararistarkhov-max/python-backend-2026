    {
      "type": "stat",
      "title": "5xx error ratio",
      "description": "Share of HTTP responses with status 5xx over the last minute.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(sum(rate(http_requests_total{job=\"shop\", datacenter=~\"$datacenter\", instance=~\"$instance\", status=~\"5..\"}[1m])) or vector(0)) / sum(rate(http_requests_total{job=\"shop\", datacenter=~\"$datacenter\", instance=~\"$instance\"}[1m]))",
          "legendFormat": "5xx",
          "range": false,
          "instant": true
