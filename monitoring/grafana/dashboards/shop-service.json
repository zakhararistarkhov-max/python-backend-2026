          },
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"shop\", datacenter=~\"$datacenter\", instance=~\"$instance\"}[1m]))",
          "legendFormat": "RPS",
          "range": false,
          "instant": true
